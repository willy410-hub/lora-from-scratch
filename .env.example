# Copy this file to .env to override any default. All are optional --
# sane defaults exist for everything and match the original scripts'
# hardcoded values.

# --- LoRA ---
# LORA_DEFAULT_RANK=8

# --- Translation (WMT16 en->de) ---
# TRANSLATION_MODEL_NAME=google/flan-t5-base
# TRANSLATION_TRAIN_SAMPLE_SIZE=5000
# TRANSLATION_BATCH_SIZE=16
# TRANSLATION_LEARNING_RATE=0.0003

# --- Summarization (CNN/DailyMail) ---
# SUMMARIZATION_MODEL_NAME=google/flan-t5-small
# SUMMARIZATION_TRAIN_SAMPLE_SIZE=1000
# SUMMARIZATION_USE_MIXED_PRECISION=true

# --- Q&A transfer (SQuAD v2) ---
# QA_MODEL_NAME=google/flan-t5-large
# QA_TRAIN_SAMPLE_SIZE=2000
# QA_UNANSWERABLE_TARGET=No answer available.
